    </servlet>

    <servlet-mapping>
        <servlet-name>MySecondServlet</servlet-name>
        <url-pattern>/second</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>My3Servlet</servlet-name>
        <servlet-class>com.anotites.servlets.ServletFrom10</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>My3Servlet</servlet-name>
        <url-pattern>/name</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>My4Servlet</servlet-name>
        <servlet-class>com.anotites.servlets.ServletFrom11</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>My4Servlet</servlet-name>
