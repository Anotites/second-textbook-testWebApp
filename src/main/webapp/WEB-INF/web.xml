        <servlet-class>com.anotites.servlets.ServletFrom14</servlet-class>
        <init-param>
            <param-name>dbURL</param-name>
            <param-value>jdbc:mysql://localhost:3306/ListExpenses</param-value>
        </init-param>
        <init-param>
            <param-name>username</param-name>
            <param-value>root</param-value>
        </init-param>
        <init-param>
            <param-name>password</param-name>
            <param-value/>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>My7Servlet</servlet-name>
        <url-pattern>/payments</url-pattern>
    </servlet-mapping>
